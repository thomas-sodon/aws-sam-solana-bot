{
  "name": "processor-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Solana swap processor lambda using NodeJS",
  "main": "dist/app.js",
  "repository": "https://github.com/thomas-sodon/aws-sam-solana-bot",
  "author": "Thomas Sodon",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "unit": "jest",
    "test": "yarn run unit",
    "test:coverage": "jest --coverage",
    "test:e2e": "RUN_E2E=1 jest",
    "check:rpc": "tsx ./scripts/check-rpc-health.ts",
    "bundle": "esbuild ./src/app.ts --bundle --minify --sourcemap --platform=node --target=es2021 --outfile=dist/app.js",
    "build": "yarn run typecheck && yarn run bundle"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1140.0",
    "@jup-ag/api": "6.0.30",
    "@project-serum/serum": "0.13.65",
    "@raydium-io/raydium-sdk": "1.3.1-beta.58",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.95.4",
    "bs58": "5.0.0",
    "config": "^3.3.11",
    "graphql": "16.8.1",
    "graphql-request": "6.1.0",
    "helius-sdk": "1.3.0",
    "node-fetch": "2.7.0"
  },
  "devDependencies": {
    "@jest/globals": "29.2.0",
    "@types/aws-lambda": "8.10.145",
    "@types/config": "^3.3.4",
    "@types/jest": "29.5.12",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "7.7.1",
    "@typescript-eslint/parser": "7.7.1",
    "esbuild": "0.14.14",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "prettier": "3.2.5",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "tsx": "4.19.2",
    "typescript": "5.4.5"
  }
}
